{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "lib/**/*",
    "app/projects/ACCodeSEA/Storyline/components/StorySection.tsx",
    "app/projects/ACCodeSEA/Join/shared/**/*.d.ts"
, "tailwind.config.js", "app/projects/JobMatch/Dashboard/components/navigationHub.tsx", "app/projects/ACCodeSEA/Admin/roles/components/RoleForm.tsx"  ],
  "exclude": ["node_modules"]
}
